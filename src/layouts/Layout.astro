---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

import ContactModal from '../components/ContactModal.astro';
import Masthead from '../components/Masthead.astro';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Ticker from '../components/Ticker.astro';
import { fallbackSeo, type SeoData } from '../lib/seo';
import { LOCALE, SITE_TAGLINE } from '../lib/site';
import type { NavKey } from '../sanity/lib/queries';

import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	active: NavKey;
	/** Full SEO record from src/lib/seo.ts. Optional so a page can still be
	 *  written with just a title; it then gets canonical and OpenGraph tags
	 *  derived from its own URL rather than none at all. */
	seo?: SeoData;
}

const { title, description = SITE_TAGLINE, active, seo } = Astro.props;

const seoData = seo ?? fallbackSeo(title, description, Astro.url.pathname);

// BCP 47 form of LOCALE, so the document language matches both the og:locale
// tag and the en-GB dates that formatDate produces.
const lang = LOCALE.replace('_', '-');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<Seo seo={seoData} />

		{/* Preloaded so the first paint already has them — swap flash is the
		    main source of layout shift on a type-led design like this. */}
		<link
			rel="preload"
			href="/fonts/playfair-var.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/baskerville-var.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="preload" href="/fonts/courier-400.woff2" as="font" type="font/woff2" crossorigin />

		{/* Renders a <vercel-analytics> custom element whose constructor fires the
		    pageview. ClientRouter swaps it on every navigation (its data-pathname
		    differs per page), so the constructor re-runs and each route is counted
		    once — no astro:page-load hook, which would double-count. */}
		<Analytics />

		<ClientRouter />
	</head>
	<body class="paper-texture">
		<Ticker />
		<Masthead active={active} />
		<slot />
		<SiteFooter />
		<ContactModal />
	</body>
</html>
