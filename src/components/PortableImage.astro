---
// Renders `image` blocks embedded in a post's Portable Text body. Without this
// astro-portabletext logs `components.type is missing "image"` and drops the
// node, which is what was happening to the inline photos in existing posts.
import { urlFor } from '../sanity/lib/image';
import type { SanityImage } from '../sanity/lib/queries';

interface Props {
	node: SanityImage;
}

const { node } = Astro.props;

const src = node?.asset ? urlFor(node).width(1400).auto('format').url() : null;
---

{
	src && (
		<figure>
			<img src={src} alt={node.alt ?? ''} loading="lazy" decoding="async" />
			{node.caption && <figcaption>{node.caption}</figcaption>}
		</figure>
	)
}

<style>
	figure {
		margin: 2rem 0;
	}

	img {
		width: 100%;
		height: auto;
		background: var(--muted);
	}

	figcaption {
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		letter-spacing: 0.06em;
		color: var(--muted-foreground);
	}
</style>
