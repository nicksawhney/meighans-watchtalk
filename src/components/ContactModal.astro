---
import { CONTACT_EMAIL, MIN_FILL_MS } from '../lib/site';

// Native <dialog> rather than a hand-rolled overlay: focus trapping, Escape to
// close, background inert, and ::backdrop all come for free and are correct.
// Rendered once from Layout; the masthead link opens it.
---

<dialog id="contact-dialog" class="contact" aria-labelledby="contact-title">
	<div class="contact__panel animate-paper-fold">
		<div class="contact__head">
			<span class="contact__eyebrow" id="contact-title">Write to Meighan</span>
			<button type="button" class="contact__close" data-contact-close>✕ Close</button>
		</div>

		<div class="contact__rule"></div>

		<form class="contact__form" data-contact-form novalidate>
			<div class="contact__field">
				<label class="contact__label" for="contact-name">Your name *</label>
				<input
					class="contact__input contact__input--display"
					id="contact-name"
					name="name"
					type="text"
					required
					maxlength="100"
					autocomplete="name"
					placeholder="Who's writing?"
				/>
			</div>

			<div class="contact__field">
				<label class="contact__label" for="contact-email">Reply-to email *</label>
				<input
					class="contact__input"
					id="contact-email"
					name="email"
					type="email"
					required
					maxlength="200"
					autocomplete="email"
					placeholder="So she can write back"
				/>
			</div>

			<div class="contact__field">
				<label class="contact__label" for="contact-message">Message *</label>
				<textarea
					class="contact__input contact__textarea"
					id="contact-message"
					name="message"
					required
					maxlength="5000"
					rows="7"
					placeholder="Pitches, corrections, and strong opinions about movements are all welcome."
				></textarea>
			</div>

			{/* Honeypot. Hidden from sighted users AND from assistive tech, and
			    skipped by the tab order — only a bot fills this in. */}
			<div class="contact__honeypot" aria-hidden="true">
				<label for="contact-company">Company</label>
				<input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
			</div>

			<p class="contact__status" data-contact-status role="status" aria-live="polite"></p>

			<button type="submit" class="contact__submit" data-contact-submit>Send message →</button>

			<p class="contact__fallback">
				Or email directly: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			</p>
		</form>

		<div class="contact__sent" data-contact-sent hidden>
			<div class="stamp-label contact__stamp">✦ Sent</div>
			<p class="contact__sentcopy">
				Thanks — your message is on its way. Meighan will reply to the address you gave.
			</p>
			<button type="button" class="contact__close contact__close--block" data-contact-close>
				Close
			</button>
		</div>
	</div>
</dialog>

<script is:inline define:vars={{ MIN_FILL_MS }}>
	// This script is inline (define:vars), so it re-executes on every
	// ClientRouter swap. Element-scoped listeners are guarded per dialog, which
	// is replaced each swap; document-scoped ones are guarded on window, which
	// is not — without that they'd stack up and showModal() would fire twice.
	function initContactDialog() {
		const dialog = document.getElementById('contact-dialog');
		if (!dialog || dialog.dataset.ready === 'true') return;
		dialog.dataset.ready = 'true';

		const form = dialog.querySelector('[data-contact-form]');
		const sent = dialog.querySelector('[data-contact-sent]');
		const status = dialog.querySelector('[data-contact-status]');
		const submit = dialog.querySelector('[data-contact-submit]');

		let openedAt = 0;

		function open(trigger) {
			// Stash on window: the reopen may happen after a page swap has
			// replaced this closure's dialog.
			window.__contactTrigger = trigger ?? null;
			openedAt = Date.now();
			status.textContent = '';
			form.hidden = false;
			sent.hidden = true;
			submit.disabled = false;
			if (!dialog.open) dialog.showModal();
		}

		// The trigger keeps its mailto href, so the link still works without JS.
		// Delegated from document, and bound exactly once per page load.
		if (!window.__contactDelegated) {
			window.__contactDelegated = true;
			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				const trigger = target.closest('[data-contact-trigger]');
				if (!trigger) return;
				event.preventDefault();
				// Re-resolve: the live dialog may be newer than any one closure.
				const current = document.getElementById('contact-dialog');
				if (current && current.__open) current.__open(trigger);
			});
		}

		dialog.__open = open;

		dialog.addEventListener('click', (event) => {
			if (event.target.closest('[data-contact-close]')) {
				dialog.close();
				return;
			}
			// Clicking the backdrop: the dialog element itself fills the viewport,
			// so a hit on it rather than the panel means outside.
			if (event.target === dialog) dialog.close();
		});

		dialog.addEventListener('close', () => {
			const trigger = window.__contactTrigger;
			if (trigger && document.contains(trigger)) trigger.focus();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			const data = Object.fromEntries(new FormData(form));
			const name = String(data.name ?? '').trim();
			const email = String(data.email ?? '').trim();
			const message = String(data.message ?? '').trim();

			if (!name || !email || !message) {
				status.textContent = 'Please fill in your name, email, and a message.';
				return;
			}
			if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				status.textContent = 'That email address does not look right.';
				return;
			}
			if (Date.now() - openedAt < MIN_FILL_MS) {
				status.textContent = 'Give that one more moment, then send again.';
				return;
			}

			submit.disabled = true;
			status.textContent = 'Sending…';

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						name,
						email,
						message,
						company: String(data.company ?? ''),
						elapsed: Date.now() - openedAt,
					}),
				});
				const result = await response.json().catch(() => ({}));

				if (!response.ok || !result.ok) {
					status.textContent =
						result.error ?? 'Something went wrong sending that. Please try the direct email.';
					submit.disabled = false;
					return;
				}

				form.hidden = true;
				sent.hidden = false;
			} catch {
				status.textContent = 'Could not reach the server. Please try the direct email.';
				submit.disabled = false;
			}
		});
	}

	initContactDialog();
	// Also once-only — astro:page-load fires on document, which survives swaps.
	if (!window.__contactPageLoadBound) {
		window.__contactPageLoadBound = true;
		document.addEventListener('astro:page-load', initContactDialog);
	}
</script>

<style>
	.contact {
		padding: 0;
		border: 0;
		background: transparent;
		max-width: min(34rem, calc(100vw - 2rem));
		width: 100%;
	}

	.contact::backdrop {
		background: rgb(26 22 14 / 0.7);
	}

	.contact__panel {
		background: var(--background);
		border: 4px solid var(--foreground);
		padding: 2rem;
	}

	.contact__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.contact__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		font-weight: 700;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--primary);
	}

	.contact__close {
		font-family: var(--font-mono);
		font-size: var(--text-label-md);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--muted-foreground);
		white-space: nowrap;
	}

	.contact__close:hover {
		color: var(--primary);
	}

	.contact__close--block {
		margin-top: 1.25rem;
		border: 2px solid var(--foreground);
		padding: 0.5rem 1.25rem;
		color: var(--foreground);
	}

	.contact__close--block:hover {
		background: var(--foreground);
		color: var(--background);
	}

	.contact__rule {
		margin: 0.75rem 0 1.25rem;
		border-top: 4px solid var(--foreground);
	}

	.contact__field {
		margin-bottom: 1.25rem;
	}

	.contact__label {
		display: block;
		margin-bottom: 0.25rem;
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	/* Mirrors the prototype's submission form: transparent field, hairline
	   underline, red on focus. */
	.contact__input {
		width: 100%;
		padding: 0.5rem 0;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-body);
		font-size: 0.875rem;
		color: var(--foreground);
		transition: border-color 0.2s ease;
	}

	.contact__input--display {
		border-bottom-width: 2px;
		border-bottom-color: var(--foreground);
		font-family: var(--font-display);
		font-size: 1.25rem;
	}

	.contact__input::placeholder {
		color: var(--muted);
	}

	.contact__input:focus {
		outline: none;
		border-bottom-color: var(--primary);
	}

	/* The underline already signals focus; a full ring would double up. */
	.contact__input:focus-visible {
		outline: none;
	}

	.contact__textarea {
		border: 0;
		border-top: 2px solid var(--foreground);
		padding-top: 0.75rem;
		line-height: 1.7;
		resize: vertical;
		min-height: 9rem;
	}

	.contact__textarea:focus {
		border-top-color: var(--primary);
	}

	.contact__honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.contact__status {
		margin: 0 0 0.75rem;
		min-height: 1.2em;
		font-family: var(--font-mono);
		font-size: var(--text-label-md);
		color: var(--primary);
	}

	.contact__submit {
		width: 100%;
		padding: 0.75rem;
		background: var(--foreground);
		color: var(--background);
		font-family: var(--font-mono);
		font-size: var(--text-label-md);
		letter-spacing: 0.4em;
		text-transform: uppercase;
		transition: background-color 0.2s ease;
	}

	.contact__submit:hover:not(:disabled) {
		background: var(--primary);
	}

	.contact__submit:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.contact__fallback {
		margin: 1rem 0 0;
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		color: var(--muted-foreground);
	}

	.contact__fallback a {
		color: var(--primary);
		word-break: break-all;
	}

	.contact__sent {
		text-align: center;
		padding: 1rem 0;
	}

	.contact__stamp {
		font-size: var(--text-label-md);
	}

	.contact__sentcopy {
		margin: 1.25rem 0 0;
		font-family: var(--font-body);
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--muted-foreground);
	}

	@media (max-width: 40rem) {
		.contact__panel {
			padding: 1.25rem;
			border-width: 3px;
		}

		.contact__label {
			letter-spacing: 0.2em;
		}

		.contact__submit {
			letter-spacing: 0.25em;
		}
	}
</style>
