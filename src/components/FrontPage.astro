---
import ArticleCard from './ArticleCard.astro';
import type { PostSummary } from '../sanity/lib/queries';

interface Props {
	posts: PostSummary[];
	/** Shown above the grid, e.g. "Today's Edition" or "Interviews". */
	heading: string;
	emptyMessage?: string;
}

const { posts, heading, emptyMessage = 'No dispatches in this section yet.' } = Astro.props;

// Posts arrive already sorted (featured first, then newest), so the lead is
// simply the head of the list — no second pass needed.
const [lead, ...rest] = posts;

// A fixed 3-up bottom row strands empty cells at small post counts, so small
// sets go entirely into the side column and only larger sets spill into a tail
// row. The tail then auto-fits, so it fills its row whatever the count.
const SIDEBAR_MAX = 3;
const spillsOver = rest.length > SIDEBAR_MAX;
const column = spillsOver ? rest.slice(0, 2) : rest;
const tail = spillsOver ? rest.slice(2) : [];

// With nothing beside it, the lead would leave a third of the row blank.
const leadIsFullWidth = column.length === 0;
---

<main class="front">
	<div class="rule-heading front__heading">
		<span class="label">{heading}</span>
	</div>

	{
		posts.length === 0 ? (
			<p class="front__empty">{emptyMessage}</p>
		) : (
			<div class="front__grid">
				{lead && (
					<div class:list={['front__lead', { 'front__lead--full': leadIsFullWidth }]}>
						<ArticleCard post={lead} size="featured" excerpt={lead.excerpt} delay={0} />
					</div>
				)}

				{column.length > 0 && (
					<div class="front__column">
						{column.map((post, i) => (
							<ArticleCard
								post={post}
								size="normal"
								excerpt={post.excerpt}
								delay={0.05 * (i + 1)}
							/>
						))}
					</div>
				)}

				{tail.length > 0 && (
					<div class="front__tail">
						{tail.map((post, i) => (
							<ArticleCard
								post={post}
								size="small"
								excerpt={post.excerpt}
								delay={0.05 * (i + 3)}
							/>
						))}
					</div>
				)}
			</div>
		)
	}
</main>

<style>
	.front {
		position: relative;
		z-index: 1;
		max-width: var(--shell);
		margin: 0 auto;
		padding: 1.5rem 1rem;
	}

	.front__heading {
		margin-bottom: 1.25rem;
	}

	.front__heading .label {
		letter-spacing: 0.4em;
		font-size: var(--text-label-md);
	}

	.front__empty {
		padding: 5rem 0;
		text-align: center;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.25rem;
		color: var(--muted-foreground);
	}

	.front__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.front__lead {
		grid-column: span 2;
	}

	/* Sole post on a section page — span everything rather than leaving a
	   third of the row blank. */
	.front__lead--full {
		grid-column: 1 / -1;
	}

	.front__column {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	/* Spans the full width and auto-fits, so the bottom row fills itself
	   whatever the post count instead of stranding empty cells. */
	.front__tail {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		align-items: start;
	}

	@media (max-width: 64rem) {
		.front__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.front__lead {
			grid-column: span 2;
		}

		.front__column {
			grid-column: span 2;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 40rem) {
		.front__grid,
		.front__column {
			grid-template-columns: 1fr;
		}

		.front__lead,
		.front__column {
			grid-column: span 1;
		}
	}
</style>
